{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyondordinary.ai/schemas/bo_cli_output.schema.json",
  "title": "BO CLI JSON Output Envelope",
  "description": "Common top-level envelope for BO CLI JSON output.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "subcommand": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error",
        "requires_refactor",
        "requires_contract_decision"
      ]
    },
    "data": {
      "type": "object"
    },
    "error": {
      "type": "string"
    }
  }
}
